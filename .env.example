# Directory the agent is allowed to organize (absolute path or ~ prefix)
ALLOWED_ROOT=~/Downloads
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
# Scheduled check (notify-only; it never moves files)
CHECK_MIN_FILES=15
CHECK_COOLDOWN_HOURS=24
CHECK_MIN_AGE_MINUTES=10
# Email skill (read-only). How to get these: docs/email-setup.md
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
# Voice skill (local only). Check setup with: npm run dev -- voice doctor
VOICE_INBOX=~/voice-inbox
WHISPER_MODEL=~/whisper-models/ggml-large-v3-turbo.bin
# Optional: a bigger local model for explaining dialect (defaults to OLLAMA_MODEL)
VOICE_LLM_MODEL=
# Words Whisper is less sure of than this (0-1) are shown as [?word]
VOICE_UNCERTAIN_P=0.5
